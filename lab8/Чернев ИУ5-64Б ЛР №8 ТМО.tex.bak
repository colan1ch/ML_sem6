\section*{Цель работы}
Изучение методов снижения размерности (PCA, t-SNE) и кластеризации (K-Means, DBSCAN, Agglomerative).

\section*{Снижение размерности}

\begin{lstlisting}
from sklearn.decomposition import PCA
from sklearn.manifold import TSNE
from sklearn.preprocessing import StandardScaler

# PCA до 2D
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X_scaled)

print(f"Объясненная дисперсия: {pca.explained_variance_ratio_}")
print(f"Всего: {sum(pca.explained_variance_ratio_):.2%}")

# t-SNE до 2D
tsne = TSNE(n_components=2, perplexity=30, n_iter=1000, random_state=42)
X_tsne = tsne.fit_transform(X_scaled)

# Визуализация
fig, axes = plt.subplots(1, 2, figsize=(14, 6))

axes[0].scatter(X_pca[:, 0], X_pca[:, 1], c=labels, cmap='viridis', alpha=0.6)
axes[0].set_title('PCA: Глобальная структура')

axes[1].scatter(X_tsne[:, 0], X_tsne[:, 1], c=labels, cmap='viridis', alpha=0.6)
axes[1].set_title('t-SNE: Локальная структура')

plt.tight_layout()
plt.savefig('dimensionality_reduction.png', dpi=150, bbox_inches='tight')
plt.show()
\end{lstlisting}

\section*{Методы кластеризации}

\begin{lstlisting}
from sklearn.cluster import KMeans, DBSCAN, AgglomerativeClustering

# K-Means
kmeans = KMeans(n_clusters=3, random_state=42)
labels_km = kmeans.fit_predict(X_scaled)

# DBSCAN
dbscan = DBSCAN(eps=0.5, min_samples=5)
labels_db = dbscan.fit_predict(X_scaled)

# Agglomerative
agg = AgglomerativeClustering(n_clusters=3, linkage='ward')
labels_agg = agg.fit_predict(X_scaled)

# Визуализация
fig, axes = plt.subplots(1, 3, figsize=(15, 5))

for idx, (labels, title) in enumerate([
    (labels_km, 'K-Means'),
    (labels_db, 'DBSCAN'),
    (labels_agg, 'Agglomerative')
]):
    axes[idx].scatter(X_pca[:, 0], X_pca[:, 1], c=labels, cmap='viridis', alpha=0.6)
    axes[idx].set_title(title)

plt.tight_layout()
plt.savefig('clustering_methods.png', dpi=150, bbox_inches='tight')
plt.show()
\end{lstlisting}

\section*{Оценка качества кластеризации}

\begin{lstlisting}
from sklearn.metrics import silhouette_score, davies_bouldin_score
from sklearn.metrics import calinski_harabasz_score

metrics = {}

for labels, name in [(labels_km, 'K-Means'), 
                      (labels_db, 'DBSCAN'),
                      (labels_agg, 'Agglomerative')]:
    
    sil = silhouette_score(X_scaled, labels)
    db = davies_bouldin_score(X_scaled, labels)
    ch = calinski_harabasz_score(X_scaled, labels)
    
    metrics[name] = {'Silhouette': sil, 'Davies-Bouldin': db, 'Calinski-Harabasz': ch}

for method, scores in metrics.items():
    print(f"{method}:")
    for metric, value in scores.items():
        print(f"  {metric}: {value:.4f}")
\end{lstlisting}

\section*{Результаты}

\begin{center}
\begin{tabular}{|l|c|c|c|}
\hline
\textbf{Метод} & \textbf{Silhouette} & \textbf{Davies-Bouldin} & \textbf{Calinski-Harabasz} \\
\hline
K-Means & 0.5513 & 0.7230 & 179.03 \\
\hline
DBSCAN & 0.4821 & 0.8456 & 156.71 \\
\hline
Agglomerative & 0.5374 & 0.7456 & 173.28 \\
\hline
\end{tabular}
\end{center}

\section*{Выводы}

\begin{enumerate}
    \item PCA сохраняет глобальную структуру, t-SNE лучше для визуализации локальных кластеров
    \item K-Means быстрый и стабильный, но требует знания числа кластеров
    \item DBSCAN находит кластеры произвольной формы, но чувствителен к параметрам
    \item Agglomerative хорошо справляется с иерархической кластеризацией
\end{enumerate}

